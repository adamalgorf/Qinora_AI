NODE_ENV=development
PORT=4000
EMAIL_WEBHOOK_SECRET=change-me
QINORA_AUTH_TOKEN_SECRET=change-me-too
QINORA_PERSISTENCE=sqlite
QINORA_POSTGRES_TENANT_ID=00000000-0000-0000-0000-000000000001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qinora
QINORA_SQLITE_PATH=data/qinora.dev.sqlite3
# stub uses a deterministic, no-credentials fallback for all 4 agents
# (Nora, Quinn, Orion, and the RFQ analysis graph - see
# application/analyze_rfq.py) - always flags for human review.
# Set to openai once OPENAI_API_KEY is filled in to enable them for real.
LLM_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Comma-separated list of allowed frontend origins, e.g.
# https://qinora-frontend.onrender.com. Only needed when the frontend is
# hosted on a different origin than the backend (split hosting); same-origin
# setups (nginx proxy, docker-compose) can leave this as "*".
CORS_ALLOWED_ORIGINS=*
# Overrides whether real per-user login (POST /auth/login) is required,
# disabling the open dev-token/no-auth fallback. Defaults to true when
# QINORA_PERSISTENCE=postgres and false otherwise, so this normally does not
# need to be set - leave unset for frictionless local development.
QINORA_REQUIRE_AUTH=

# --- Outlook / Microsoft 365 intake bridge (qinora.workers.outlook_bridge) ---
# See integrations/outlook-intake-bridge/README.md. Fill in EITHER
# OUTLOOK_CLIENT_SECRET (application auth) OR OUTLOOK_REFRESH_TOKEN
# (delegated auth from `python -m qinora.workers.outlook_bridge login`).
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REFRESH_TOKEN=
OUTLOOK_MAILBOXES=test.spedition@sandahls.com,qinora.ai@sandahls.com
OUTLOOK_SEND_MAILBOX=test.spedition@sandahls.com
OUTLOOK_SENDER_NAME=Sandahls
# Where the bridge reaches the backend (docker-compose sets this itself).
QINORA_API_BASE_URL=http://localhost:8000
