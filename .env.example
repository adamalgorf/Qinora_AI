NODE_ENV=development
PORT=4000
EMAIL_WEBHOOK_SECRET=change-me
QINORA_AUTH_TOKEN_SECRET=change-me-too
QINORA_PERSISTENCE=sqlite
QINORA_POSTGRES_TENANT_ID=00000000-0000-0000-0000-000000000001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qinora
QINORA_SQLITE_PATH=data/qinora.dev.sqlite3
# LLM_PROVIDER=stub uses a deterministic, no-credentials fallback (always
# flags requests for human review). Set to azure_openai once real Azure
# OpenAI credentials below are filled in to enable request_parsing_agent.
LLM_PROVIDER=stub
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
