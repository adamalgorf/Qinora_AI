NODE_ENV=development
PORT=4000
EMAIL_WEBHOOK_SECRET=change-me
QINORA_AUTH_TOKEN_SECRET=change-me-too
QINORA_PERSISTENCE=sqlite
QINORA_POSTGRES_TENANT_ID=00000000-0000-0000-0000-000000000001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qinora
QINORA_SQLITE_PATH=data/qinora.dev.sqlite3
LLM_PROVIDER=stub
# Comma-separated list of allowed frontend origins, e.g.
# https://qinora-frontend.onrender.com. Only needed when the frontend is
# hosted on a different origin than the backend (split hosting); same-origin
# setups (nginx proxy, docker-compose) can leave this as "*".
CORS_ALLOWED_ORIGINS=*
# If set, the app requires this shared password to log in (POST /auth/login)
# before granting access, and disables the open dev-token/no-auth fallback.
# Leave unset for frictionless local development.
QINORA_APP_PASSWORD=
